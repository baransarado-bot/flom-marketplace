{
  "name": "flom-marketplace-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor mobile shell for FLOM Marketplace",
  "scripts": {
    "build:bridge": "esbuild src/bridge.js --bundle --format=iife --target=es2020 --outfile=../assets/mobile-bridge.js",
    "check:release": "node scripts/require-production-url.mjs",
    "sync": "npm run check:release && npm run build:bridge && cap sync",
    "sync:local": "npm run build:bridge && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
